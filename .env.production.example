# ───────────────────────────────────────────────────────────────────────────
# .env de PRODUCCIÓN (diderot.usal.es). Copiar como .env junto a
# docker-compose.prod.yml, rellenar y proteger:  chmod 600 .env
# NUNCA subir este fichero a git.
# ───────────────────────────────────────────────────────────────────────────

# Base de datos (la usa el compose para crear la BD y componer DATABASE_URL).
# Contraseña larga y SIN caracteres especiales de URL:  openssl rand -hex 24
POSTGRES_USER=diderot
POSTGRES_PASSWORD=
POSTGRES_DB=diderot_web

# Puerto local en el que escucha la app (solo 127.0.0.1; el proxy inverso
# con HTTPS es quien publica la web).
APP_PORT=3000

# URL pública canónica (sin barra final)
SITE_URL=https://diderot.usal.es
NEXTAUTH_URL=https://diderot.usal.es
# Secreto de sesiones:  openssl rand -base64 32
NEXTAUTH_SECRET=

# Cuentas SUPER_ADMIN que crea la semilla (contraseñas propias, ≥ 12 caracteres;
# la semilla se niega a usar las de desarrollo). Después, desde el panel →
# Configuración, cada persona cambia la suya y se dan de alta las demás.
ADMIN_EMAIL=javiermerchan@usal.es
ADMIN_PASSWORD=
TECH_ADMIN_EMAIL=iuce.tecnico@usal.es
TECH_ADMIN_PASSWORD=

# Formulario de contacto (Resend). Sin clave, los mensajes se guardan en el
# panel (Mensajes) y no se envía correo.
RESEND_API_KEY=
EMAIL_FROM=DIDEROT <no-reply@diderot.usal.es>
CONTACT_TO=javiermerchan@usal.es

# Auto-traducción ES→EN al guardar (opcional; clave de DeepL API Free «…:fx»)
DEEPL_API_KEY=
