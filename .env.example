# Copia este archivo como .env y rellena los valores.
# En producción: .env junto a docker-compose.prod.yml (ver README → Despliegue).

# PostgreSQL local (arranca con: docker compose up -d)
# Puerto 5436 en el host (5433 = web IUCE, 5434 = DIGIFOLK, 5435 = IETIC27)
DATABASE_URL=postgresql://diderot:diderot-dev@localhost:5436/diderot_web

# URL pública del sitio (enlaces absolutos, sitemap, correos)
SITE_URL=http://localhost:3000

# NextAuth.js v5 (Credentials: email + contraseña)
NEXTAUTH_URL=http://localhost:3000
# Genera con: openssl rand -base64 32   (OBLIGATORIO y distinto en producción)
NEXTAUTH_SECRET=cambia-este-secret-en-produccion
# Detrás de un proxy inverso (Apache/nginx) en producción:
# AUTH_TRUST_HOST=true

# Cuenta SUPER_ADMIN inicial que crea el seed (cámbiala en producción)
ADMIN_EMAIL=diderot@usal.es
ADMIN_PASSWORD=diderot-admin-dev
# Cuenta técnica (SUPER_ADMIN) que crea el seed; sin contraseña propia usa ADMIN_PASSWORD
TECH_ADMIN_EMAIL=iuce.tecnico@usal.es
# TECH_ADMIN_PASSWORD=

# DeepL (auto-traducción ES→EN al guardar; opcional)
# https://www.deepl.com/pro-api — plan gratuito: 500k caracteres/mes.
# Las claves free terminan en ":fx". Sin clave, la traducción se omite.
DEEPL_API_KEY=deepl-placeholder
